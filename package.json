{
  "name": "electron-bgremove",
  "version": "1.0.0",
  "description": "Electron app for background removal using U²Net ONNX model",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "NODE_ENV=development electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder",
    "build:win": "node scripts/build-win.js",
    "build:mac": "node scripts/build-mac.js",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "node scripts/build-all.js",
    "rebuild": "electron-builder install-app-deps",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/sample-test.js"
  },
  "keywords": ["electron", "background-removal", "onnx", "u2net"],
  "author": "SaptaRatna",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-vite": "^1.0.28",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^4.5.0"
  },
  "dependencies": {
    "onnxruntime-node": "^1.16.3",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "com.saptaratna.electron-bgremove",
    "productName": "Background Remover",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/sharp/build/Release/sharp-win32-*",
      "!node_modules/sharp/build/Release/sharp-linux-*",
      "!node_modules/@img/sharp-win32-*",
      "!node_modules/@img/sharp-linux-*"
    ],
    "extraResources": [
      {
        "from": "assets/models/",
        "to": "models/",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Background Remover"
    },
    "dmg": {
      "title": "BackgroundRemover",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
